enum MaintenanceContractStatus {
  PENDING
  ACTIVE
  REJECTED
  EXPIRED
  TERMINATED

  @@map("maint_contract_status")
}

model MaintenanceContract {
  id                String   @id @default(uuid()) @db.Uuid
  elevatorId        String   @map("elevator_id") @db.Uuid
  maintenanceOrgId  String   @map("maintenance_org_id") @db.Uuid
  serviceType       String   @default("MAINTENANCE") @map("service_type") @db.VarChar(30)
  contractNumber    String?  @map("contract_number") @db.VarChar(50)
