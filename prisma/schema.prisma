  certificates    Certificate[]
  fieldAssignment FieldInspectionAssignment?

  @@index([elevatorId], map: "idx_insp_elv")
  @@index([inspectorId], map: "idx_insp_inspector")
  @@index([scheduledDate], map: "idx_insp_scheduled")
  @@index([status], map: "idx_insp_status")
  @@map("insp_inspections")
}

model FieldInspectionAssignment {
  id            String                          @id @default(uuid()) @db.Uuid
  applicationId String?                         @map("application_id") @db.Uuid
  elevatorId    String?                         @map("elevator_id") @db.Uuid
  assigneeId    String                          @map("assignee_id") @db.Uuid
  assignedById  String                          @map("assigned_by_id") @db.Uuid
  scheduledDate DateTime                        @map("scheduled_date") @db.Date
  status        FieldInspectionAssignmentStatus @default(SCHEDULED)
  instructions  String?                         @db.Text
  inspectionId  String?                         @unique @map("inspection_id") @db.Uuid
  verificationResult InspectionResult?          @map("verification_result")
  verificationFindings String?                  @map("verification_findings") @db.Text
  reportDocumentId String?                      @map("report_document_id") @db.Uuid
  conductedDate DateTime?                       @map("conducted_date") @db.Date
  cancelledAt   DateTime?                       @map("cancelled_at") @db.Timestamptz
  cancelReason  String?                         @map("cancel_reason") @db.Text
  createdAt     DateTime                        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime                        @updatedAt @map("updated_at") @db.Timestamptz

  application Application? @relation("ApplicationFieldVerification", fields: [applicationId], references: [id], onDelete: Cascade)
  elevator   Elevator?    @relation(fields: [elevatorId], references: [id])
  assignee   AuthUser    @relation("FieldInspectionAssignee", fields: [assigneeId], references: [id])
  assignedBy AuthUser    @relation("FieldInspectionAssignedBy", fields: [assignedById], references: [id])
  inspection Inspection? @relation(fields: [inspectionId], references: [id])
  reportDocument Document? @relation("FieldInspectionReport", fields: [reportDocumentId], references: [id])

  @@index([assigneeId, status], map: "idx_field_insp_assignee")
  @@index([elevatorId], map: "idx_field_insp_elevator")
  @@index([applicationId], map: "idx_field_insp_application")
  @@index([scheduledDate], map: "idx_field_insp_scheduled")
  @@map("insp_field_assignments")
}

