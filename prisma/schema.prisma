model Certificate {
  id               String            @id @default(uuid()) @db.Uuid
  certificateNumber String           @unique @map("certificate_number") @db.VarChar(30)
  elevatorId       String            @map("elevator_id") @db.Uuid
  type             CertificateType
  status           CertificateStatus @default(ACTIVE)
  issuedDate       DateTime          @map("issued_date") @db.Date
  expiryDate       DateTime?         @map("expiry_date") @db.Date
  issuedByOrgId    String?           @map("issued_by_org_id") @db.Uuid
  issuedByUserId   String?           @map("issued_by_user_id") @db.Uuid
  applicationId    String?           @map("application_id") @db.Uuid
  inspectionId     String?           @map("inspection_id") @db.Uuid
  documentId       String?           @map("document_id") @db.Uuid
  supersededById   String?           @map("superseded_by_id") @db.Uuid
  revokedAt        DateTime?         @map("revoked_at") @db.Timestamptz
  revokedReason    String?           @map("revoked_reason") @db.Text
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz

  elevator      Elevator      @relation(fields: [elevatorId], references: [id])
  issuedByOrg   Organization? @relation(fields: [issuedByOrgId], references: [id])
  issuedByUser  AuthUser?     @relation("CertificateIssuedByUser", fields: [issuedByUserId], references: [id])
