// =============================================================================
// INSPECTIONS
// =============================================================================

model Inspection {
  id                  String           @id @default(uuid()) @db.Uuid
  elevatorId          String           @map("elevator_id") @db.Uuid
  inspectorId         String           @map("inspector_id") @db.Uuid
  type                InspectionType
  status              InspectionResult @default(PENDING)
  scheduledDate       DateTime         @map("scheduled_date") @db.Date
  conductedDate       DateTime?        @map("conducted_date") @db.Date
  result              InspectionResult?
  findings            String?          @db.Text
  conditions          String?          @db.Text
  approvedBodyNumber  String?          @map("approved_body_number") @db.VarChar(50)
  examinationType     String?          @map("examination_type") @db.VarChar(50)
  nextInspectionDate  DateTime?        @map("next_inspection_date") @db.Date
  reportDocumentId    String?          @map("report_document_id") @db.Uuid
  certificateId       String?          @unique @map("certificate_id") @db.Uuid
  createdAt           DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  elevator        Elevator     @relation(fields: [elevatorId], references: [id])
  inspector       AuthUser     @relation(fields: [inspectorId], references: [id])
  reportDocument  Document?    @relation("InspectionReport", fields: [reportDocumentId], references: [id])
