// =============================================================================
// ISHMT Digital Elevator Registry System - Prisma Schema
// Version: 1.0 (Phase 1 Scaffolding)
// Aligned with: docs/architecture/06-database-design.md + approved extensions
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// ENUMS
// =============================================================================

