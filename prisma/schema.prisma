// =============================================================================
// GEOGRAPHY - Municipality Registry (no free-text municipality names)
// =============================================================================

model GeoRegion {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique @db.VarChar(10)
  nameSq    String   @map("name_sq") @db.VarChar(100)
  nameEn    String?  @map("name_en") @db.VarChar(100)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  municipalities GeoMunicipality[]

  @@map("geo_regions")
}

model GeoMunicipality {
  id                 String   @id @default(uuid()) @db.Uuid
  regionId           String   @map("region_id") @db.Uuid
  code               String   @unique @db.VarChar(10)
  legacyRegistryCode String?  @map("legacy_registry_code") @db.VarChar(5)
  nameSq             String   @map("name_sq") @db.VarChar(100)
  nameEn             String?  @map("name_en") @db.VarChar(100)
  isActive           Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  region              GeoRegion              @relation(fields: [regionId], references: [id])
  administrativeUnits GeoAdministrativeUnit[]
  organizations       Organization[]
  applicationData     ApplicationData[]
  elevators           Elevator[]
  citizenReports      CitizenReport[]
  registrySequences       RegistrySequence[]
  legacyRegistrySequences LegacyRegistrySequence[]
  buildings               Building[]

  @@index([regionId], map: "idx_geo_municipality_region")
  @@index([code], map: "idx_geo_municipality_code")
  @@map("geo_municipalities")
}

model GeoAdministrativeUnit {
  id             String   @id @default(uuid()) @db.Uuid
  municipalityId String   @map("municipality_id") @db.Uuid
  code           String   @db.VarChar(20)
  nameSq         String   @map("name_sq") @db.VarChar(100)
  nameEn         String?  @map("name_en") @db.VarChar(100)
  unitType       String?  @map("unit_type") @db.VarChar(50)
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  municipality  GeoMunicipality @relation(fields: [municipalityId], references: [id])
  applicationData ApplicationData[]
  elevators     Elevator[]
  buildings     Building[]

  @@unique([municipalityId, code], map: "uq_admin_unit_municipality_code")
  @@index([municipalityId], map: "idx_admin_unit_municipality")
  @@map("geo_administrative_units")
}

model Building {
  id                   String        @id @default(uuid()) @db.Uuid
  buildingCode         String?       @unique @map("building_code") @db.VarChar(30)
  name                 String?       @db.VarChar(255)
  address              String        @db.Text
  municipalityId       String        @map("municipality_id") @db.Uuid
  administrativeUnitId String?       @map("administrative_unit_id") @db.Uuid
  buildingType         BuildingType? @map("building_type")
  entrance             String?       @db.VarChar(100)
  floorsCount          Int?          @map("floors_count")
  gpsLatitude          Decimal?      @map("gps_latitude") @db.Decimal(10, 7)
  gpsLongitude         Decimal?      @map("gps_longitude") @db.Decimal(10, 7)
  primaryOwnerOrgId    String?       @map("primary_owner_org_id") @db.Uuid
  createdAt            DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime      @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt            DateTime?     @map("deleted_at") @db.Timestamptz

  municipality       GeoMunicipality        @relation(fields: [municipalityId], references: [id])
  administrativeUnit GeoAdministrativeUnit? @relation(fields: [administrativeUnitId], references: [id])
  primaryOwnerOrg    Organization?          @relation("BuildingPrimaryOwner", fields: [primaryOwnerOrgId], references: [id])
  elevators          Elevator[]

  @@index([municipalityId], map: "idx_building_municipality")
  @@index([address], map: "idx_building_address")
  @@index([primaryOwnerOrgId], map: "idx_building_owner")
  @@index([deletedAt], map: "idx_building_active")
  @@map("geo_buildings")
}

// =============================================================================
// AUTHENTICATION & AUTHORIZATION
// =============================================================================

model AuthUser {
  id               String    @id @default(uuid()) @db.Uuid
  email            String    @unique @db.VarChar(255)
  passwordHash     String?   @map("password_hash") @db.VarChar(255)
  firstName        String    @map("first_name") @db.VarChar(100)
  lastName         String    @map("last_name") @db.VarChar(100)
  phone            String?   @db.VarChar(20)
  nid              String?   @unique @db.VarChar(20)
  idCardNumber     String?   @map("id_card_number") @db.VarChar(20)
  fatherName       String?   @map("father_name") @db.VarChar(100)
  motherName       String?   @map("mother_name") @db.VarChar(100)
  birthDate        DateTime? @map("birth_date") @db.Date
  isActive         Boolean   @default(true) @map("is_active")
  emailVerified    Boolean   @default(false) @map("email_verified")
  pendingEmail     String?   @map("pending_email") @db.VarChar(255)
  twoFactorEnabled Boolean   @default(false) @map("two_factor_enabled")
  twoFactorSecret  String?   @map("two_factor_secret") @db.VarChar(64)
  lastLoginAt      DateTime? @map("last_login_at") @db.Timestamptz
  failedLoginCount Int       @default(0) @map("failed_login_count")
  lockedUntil      DateTime? @map("locked_until") @db.Timestamptz
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz

  accounts              Account[]
  sessions              Session[]
  memberships           OrgMembership[]
  createdOrganizations  Organization[]         @relation("OrgCreatedBy")
  createdApplications   Application[]          @relation("ApplicationCreatedBy")
  assignedApplications  Application[]          @relation("ApplicationInspector")
  currentAssignedApplications Application[]    @relation("ApplicationCurrentAssignee")
  workflowHistory       ApplicationWorkflowHistory[]
  applicationFieldReviewsAssigned ApplicationFieldReviewAssignment[] @relation("ApplicationFieldReviewInspector")
  applicationFieldReviewsCreated  ApplicationFieldReviewAssignment[] @relation("ApplicationFieldReviewAssignedBy")
  applicationFieldReviewsReplaced ApplicationFieldReviewAssignment[] @relation("ApplicationFieldReviewReplacedBy")
  applicationParticipations       ApplicationParticipation[]         @relation("ApplicationParticipationUser")
  applicationInternalNotes        ApplicationInternalNote[]          @relation("ApplicationInternalNoteAuthor")
  confirmedElevators    Elevator[]               @relation("ElevatorConfirmedBy")
  statusHistory         ElevatorStatusHistory[]
  ownershipChanges      ElevatorOwnershipHistory[] @relation("OwnershipCreatedBy")
  delegationsAssigned   ElevatorDelegationHistory[] @relation("DelegationAssignedBy")
  technicalVersions     ElevatorTechnicalDataVersion[]
  issuedCertificates    Certificate[]            @relation("CertificateIssuedByUser")
  uploadedDocuments     Document[]
  documentAccessLogs    DocumentAccessLog[]
  maintenanceRecords    MaintenanceRecord[]
  inspections           Inspection[]
  fieldInspectionsAssigned FieldInspectionAssignment[] @relation("FieldInspectionAssignee")
  fieldInspectionsCreated  FieldInspectionAssignment[] @relation("FieldInspectionAssignedBy")
  citizenReports        CitizenReport[]          @relation("CitizenReporter")
  assignedReports       CitizenReport[]          @relation("ReportInspector")
  reportActions         CitizenReportAction[]
  reportedIncidents     Incident[]               @relation("IncidentReporter")
  assignedIncidents     Incident[]               @relation("IncidentAssignee")
  notifications         Notification[]
  notificationPrefs     NotificationPreference[]
  auditLogs             AuditLog[]
  configUpdates         SystemConfig[]
  createdLicenses       OrganizationLicense[]
  qkbValidations        QkbValidation[]
  createdTemplates      DocumentTemplate[]
  scheduledReminders    ScheduledReminder[]
  sentInvitations       OrgInvitation[]          @relation("InvitationSentBy")
  acceptedInvitations   OrgInvitation[]          @relation("InvitationAcceptedBy")
  passwordResetTokens   PasswordResetToken[]
  qrPlacementConfirmations QrCode[] @relation("QrPlacementConfirmedBy")
  applicationDelegationsInvited ApplicationDelegation[] @relation("ApplicationDelegationInvitedBy")
  applicationsReturned Application[] @relation("ApplicationReturnedBy")

  @@index([email], map: "idx_auth_users_email")
  @@index([nid], map: "idx_auth_users_nid")
  @@index([deletedAt], map: "idx_auth_users_active")
  @@map("auth_users")
}

model AuthRole {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique @db.VarChar(50)
  name        String  @db.VarChar(100)
  description String? @db.Text

  memberships     OrgMembership[]
  rolePermissions AuthRolePermission[]
  invitations     OrgInvitation[]

  @@map("auth_roles")
}

model AuthPermission {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique @db.VarChar(100)
  module      String  @db.VarChar(50)
  action      String  @db.VarChar(50)
  description String? @db.Text

  rolePermissions AuthRolePermission[]

  @@map("auth_permissions")
}

model AuthRolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       AuthRole       @relation(fields: [roleId], references: [id])
  permission AuthPermission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
  @@map("auth_role_permissions")
}

// NextAuth adapter models
model Account {
  id                String  @id @default(uuid()) @db.Uuid
  userId            String  @map("user_id") @db.Uuid
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user AuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("auth_accounts")
}

model Session {
  id           String   @id @default(uuid()) @db.Uuid
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id") @db.Uuid
  expires      DateTime @db.Timestamptz

  user AuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("auth_sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime @db.Timestamptz

  @@unique([identifier, token])
  @@map("auth_verification_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  usedAt    DateTime? @map("used_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user AuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_password_reset_user")
  @@index([expiresAt], map: "idx_password_reset_expires")
  @@map("auth_password_reset_tokens")
}

// =============================================================================
// ORGANIZATIONS
// =============================================================================

model Organization {
  id                  String    @id @default(uuid()) @db.Uuid
  type                OrgType
  name                String    @db.VarChar(255)
  nipt                String?   @unique @db.VarChar(20)
  legalForm           String?   @map("legal_form") @db.VarChar(100)
  address             String?   @db.Text
  municipalityId      String?   @map("municipality_id") @db.Uuid
  phone               String?   @db.VarChar(20)
  email               String?   @db.VarChar(255)
  representativeName  String?   @map("representative_name") @db.VarChar(255)
  representativeNid   String?   @map("representative_nid") @db.VarChar(20)
  representativePhone String?   @map("representative_phone") @db.VarChar(20)
  representativeEmail String?   @map("representative_email") @db.VarChar(255)
  ownerBuildingRole   OwnerBuildingRole? @map("owner_building_role")
  status              OrgStatus @default(ACTIVE)
  qkbValidated        Boolean   @default(false) @map("qkb_validated")
  qkbValidatedAt      DateTime? @map("qkb_validated_at") @db.Timestamptz
  qkbValidationData   Json?     @map("qkb_validation_data")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt           DateTime? @map("deleted_at") @db.Timestamptz
  createdById         String?   @map("created_by") @db.Uuid

  municipality        GeoMunicipality? @relation(fields: [municipalityId], references: [id])
  createdBy           AuthUser?        @relation("OrgCreatedBy", fields: [createdById], references: [id])
  memberships         OrgMembership[]
  licenses            OrganizationLicense[]
  qkbValidations      QkbValidation[]

  ownerApplications      Application[] @relation("ApplicationOwner")
  installerApplications  Application[] @relation("ApplicationInstaller")
  certifierApplications  Application[] @relation("ApplicationCertifier")
  ownerElevators         Elevator[]    @relation("ElevatorOwner")
  installerElevators     Elevator[]    @relation("ElevatorInstaller")
  certifierElevators     Elevator[]    @relation("ElevatorCertifier")
  maintenanceElevators   Elevator[]    @relation("ElevatorMaintenance")
  responsibleEntities    ElevatorResponsibleEntity[]
  issuedCertificates     Certificate[]
  maintenanceContracts   MaintenanceContract[]
  maintenanceRecords     MaintenanceRecord[]
  delegations            ElevatorDelegationHistory[]
  ownershipHistoryOld    ElevatorOwnershipHistory[] @relation("OwnershipOldOwner")
  ownershipHistoryNew    ElevatorOwnershipHistory[] @relation("OwnershipNewOwner")
  invitations            OrgInvitation[]
  applicationDelegations ApplicationDelegation[]
  ownedBuildings         Building[] @relation("BuildingPrimaryOwner")

  @@index([type, status], map: "idx_org_type_status")
  @@index([nipt], map: "idx_org_nipt")
  @@index([municipalityId], map: "idx_org_municipality")
  @@index([deletedAt], map: "idx_org_active")
  @@map("org_organizations")
}

model OrgMembership {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  roleId         String    @map("role_id") @db.Uuid
  isPrimary      Boolean   @default(false) @map("is_primary")
  joinedAt       DateTime  @default(now()) @map("joined_at") @db.Timestamptz
  deactivatedAt  DateTime? @map("deactivated_at") @db.Timestamptz

  user         AuthUser     @relation(fields: [userId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])
  role         AuthRole     @relation(fields: [roleId], references: [id])

  @@unique([userId, organizationId, roleId], map: "uq_user_org_role")
  @@index([userId], map: "idx_membership_user")
  @@index([organizationId], map: "idx_membership_org")
  @@map("org_memberships")
}

model OrganizationLicense {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  licenseNumber  String    @map("license_number") @db.VarChar(50)
  licenseType    String    @map("license_type") @db.VarChar(50)
  issuedDate     DateTime  @map("issued_date") @db.Date
  expiryDate     DateTime  @map("expiry_date") @db.Date
  scope          String?   @db.Text
  status         OrgStatus @default(ACTIVE)
  issuedBy       String?   @map("issued_by") @db.VarChar(255)
  documentId     String?   @map("document_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
