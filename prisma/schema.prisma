  body      String   @db.Text
  variables Json?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("sys_notification_templates")
}

model SystemConfig {
  key         String   @id @db.VarChar(100)
  value       Json
  description String?  @db.Text
  updatedById String?  @map("updated_by") @db.Uuid
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  updatedBy AuthUser? @relation(fields: [updatedById], references: [id])

  @@map("sys_config")
}

model RegistrySequence {
  id             String @id @default(uuid()) @db.Uuid
  municipalityId String @map("municipality_id") @db.Uuid
  year           Int
  lastSequence   Int    @default(0) @map("last_sequence")

  municipality GeoMunicipality @relation(fields: [municipalityId], references: [id])

  @@unique([municipalityId, year], map: "uq_registry_seq_mun_year")
  @@map("sys_registry_sequences")
}

model ApplicationSequence {
  id           String @id @default(uuid()) @db.Uuid
  year         Int
  typeCode     String @map("type_code") @db.VarChar(10)
  lastSequence Int    @default(0) @map("last_sequence")

  @@unique([year, typeCode], map: "uq_app_seq_year_type")
  @@map("sys_application_sequences")
}

model CertificateSequence {
  id           String @id @default(uuid()) @db.Uuid
  year         Int
  typeCode     String @map("type_code") @db.VarChar(10)
  lastSequence Int    @default(0) @map("last_sequence")

  @@unique([year, typeCode], map: "uq_cert_seq_year_type")
  @@map("sys_certificate_sequences")
}

model LegacyRegistrySequence {
  id             String @id @default(uuid()) @db.Uuid
  municipalityId String @map("municipality_id") @db.Uuid
  lastSequence   Int    @default(0) @map("last_sequence")

  municipality GeoMunicipality @relation(fields: [municipalityId], references: [id])

  @@unique([municipalityId], map: "uq_legacy_registry_seq_mun")
  @@map("sys_legacy_registry_sequences")
}

model SysJobRun {
  id          String       @id @default(uuid()) @db.Uuid
  jobType     String       @map("job_type") @db.VarChar(50)
  status      JobRunStatus
  startedAt   DateTime     @default(now()) @map("started_at") @db.Timestamptz
  completedAt DateTime?    @map("completed_at") @db.Timestamptz
  metadata    Json?
  errorLog    Json?        @map("error_log")

  @@index([jobType, startedAt], map: "idx_job_run_type_started")
  @@map("sys_job_runs")
}

model ReminderRule {
  id           String             @id @default(uuid()) @db.Uuid
  entityType   ReminderEntityType @map("entity_type")
  daysBefore   Int                @map("days_before")
  channel      NotificationChannel
  isActive     Boolean            @default(true) @map("is_active")
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz

  @@unique([entityType, daysBefore, channel], map: "uq_reminder_rule")
  @@map("sys_reminder_rules")
}

model ScheduledReminder {
  id           String             @id @default(uuid()) @db.Uuid
  entityType   ReminderEntityType @map("entity_type")
  entityId     String             @map("entity_id") @db.Uuid
  elevatorId   String?            @map("elevator_id") @db.Uuid
  userId       String             @map("user_id") @db.Uuid
  channel      NotificationChannel
  daysBefore   Int                @map("days_before")
  targetDate   DateTime           @map("target_date") @db.Date
  scheduledFor DateTime           @map("scheduled_for") @db.Timestamptz
  sentAt       DateTime?          @map("sent_at") @db.Timestamptz
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz

  elevator Elevator? @relation(fields: [elevatorId], references: [id])
  user     AuthUser  @relation(fields: [userId], references: [id])

  @@index([scheduledFor, sentAt], map: "idx_scheduled_reminder_due")
  @@index([entityType, entityId], map: "idx_scheduled_reminder_entity")
  @@map("sys_scheduled_reminders")
}

// =============================================================================
// AUDIT
// =============================================================================

model AuditLog {
  id            String      @id @default(uuid()) @db.Uuid
  actorId       String?     @map("actor_id") @db.Uuid
  action        AuditAction
  entityType    String      @map("entity_type") @db.VarChar(50)
  entityId      String      @map("entity_id") @db.Uuid
  beforeState   Json?       @map("before_state")
  afterState    Json?       @map("after_state")
  metadata      Json?
  ipAddress     String?     @map("ip_address") @db.VarChar(45)
  userAgent     String?     @map("user_agent") @db.Text
  correlationId String?     @map("correlation_id") @db.Uuid
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz

  actor AuthUser? @relation(fields: [actorId], references: [id])

  @@index([entityType, entityId], map: "idx_audit_entity")
  @@index([actorId], map: "idx_audit_actor")
  @@index([action], map: "idx_audit_action")
  @@index([createdAt], map: "idx_audit_created")
  @@index([correlationId], map: "idx_audit_correlation")
  @@map("audit_logs")
}
