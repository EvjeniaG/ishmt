# =============================================================================
# ISHMT Digital Elevator Registry System - Environment Variables
# Copy to .env and adjust values for your environment
# =============================================================================

# Application
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="ISHMT Digital Elevator Registry"

# Database (PostgreSQL)
DATABASE_URL="postgresql://ishmtt:ishmtt_secret@localhost:5432/ishmtt_registry?schema=public"

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-to-a-secure-random-string-min-32-chars

# Document Storage (MinIO / S3-compatible)
STORAGE_PROVIDER=minio
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=ishmtt_minio
STORAGE_SECRET_KEY=ishmtt_minio_secret
STORAGE_BUCKET=ishmtt-documents
STORAGE_REGION=us-east-1
STORAGE_USE_SSL=false

# QR Code Public Profile
# Opsionale; nëse mungon, përdoret NEXT_PUBLIC_APP_URL. Mos përfshini /q në fund.
NEXT_PUBLIC_QR_BASE_URL=http://localhost:3000

# Email (Phase 1 - optional, notifications)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@ishmt.gov.al

# Seed (development only)
SEED_DEFAULT_PASSWORD=IshmittDev2026!
SEED_DEV_USERS=true

# Vetëm të dhëna demo në zhvillim (fsheh regjistrin legacy / Excel). Vendos false për të parë migrimin.
ISHMT_DEMO_DATA=true

# Butonat «Plotëso me të dhëna demo» (regjistrim, formularë, login). Aktiv edhe pas deploy me true.
ISHMT_DEMO_TOOLS=true

# System defaults (override via sys_config after seed)
DEFAULT_MAINTENANCE_INTERVAL_DAYS=30
DEFAULT_INSPECTION_INTERVAL_MONTHS=12
DEFAULT_CERTIFICATE_WARNING_DAYS=30,15,7,1
DEFAULT_APPLICATION_EXPIRY_DAYS=90

# Reminder engine
REMINDER_SCHEDULER_ENABLED=true
REMINDER_CHECK_CRON="0 6 * * *"

# Scheduled jobs (license expiry, invitation expiry)
CRON_SECRET=change-me-to-a-secure-cron-secret

# Rate limiting
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_PUBLIC_PER_MINUTE=60

# Logging
LOG_LEVEL=info
