# =============================================================================
# ISHMT - Vercel deploy (Neon DB + Supabase Storage S3)
# Kopjoni në Vercel → Settings → Environment Variables (Production)
# =============================================================================

# --- App (pas deploy, zëvendësoni me URL-në reale) ---
NEXTAUTH_URL=https://your-project.vercel.app
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32
NEXT_PUBLIC_APP_URL=https://your-project.vercel.app
NEXT_PUBLIC_APP_NAME="ISHMT Digital Elevator Registry"
NEXT_PUBLIC_QR_BASE_URL=https://your-project.vercel.app/q

# --- PostgreSQL (Neon - përdorni string me "-pooler") ---
DATABASE_URL=postgresql://USER:PASS@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# --- Dokumentet (Supabase Storage - S3 protocol, JO publishable/secret API keys) ---
# Supabase → Storage → Configuration → S3 → Enable → Generate access key
STORAGE_PROVIDER=s3
STORAGE_ENDPOINT=https://YOUR_PROJECT_REF.storage.supabase.co/storage/v1/s3
STORAGE_ACCESS_KEY=your_s3_access_key_id
STORAGE_SECRET_KEY=your_s3_secret_access_key
STORAGE_BUCKET=ishmtt-documents
STORAGE_REGION=us-east-1
STORAGE_USE_SSL=true

# --- Prod ---
SEED_DEV_USERS=false
NODE_ENV=production
ISHMT_DEMO_DATA=true
ISHMT_DEMO_TOOLS=true
CRON_SECRET=generate-a-long-random-secret

# Pas deploy: ngarko databazën demo të plotë nga Mac:
#   DATABASE_URL="..." ./scripts/deploy/setup-remote-db.sh
# Ose kopje e saktë e lokale:
#   DATABASE_URL="..." ./scripts/deploy/restore-local-backup-to-remote.sh

# =============================================================================
# NUK nevojiten në Vercel (Supabase Auth/JS - app-i përdor NextAuth):
# SUPABASE_URL, SUPABASE_PUBLISHABLE_KEY, SUPABASE_SECRET_KEY
# =============================================================================
